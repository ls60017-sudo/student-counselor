rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // كل مستخدم يقدر يقرأ ويكتب بياناته فقط (تحت users/{uid}/...)
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Update 137: مستند عام واحد لكل مستخدم (اختياري) يحتوي فقط على إحصائيات وملخصات
    // مهنية مجمّعة (بدون أي بيانات طالب فردية) لصفحة "المعاينة العامة" (showcase.html)
    // التي تُفتح عبر رابط/QR بدون تسجيل دخول. القراءة عامة عمدًا؛ الكتابة تبقى محصورة
    // بصاحب الحساب فقط، تمامًا مثل بقية بياناته.
    match /public_showcase/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
